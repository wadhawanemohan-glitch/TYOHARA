# Copy to ".env" for local development.
# On Vercel set this under Project Settings -> Environment Variables.

# Address of your backend API (no trailing slash)
VITE_API_URL=http://localhost:5000

# Captcha on signup and login (optional). Create a free site at
# https://dash.cloudflare.com -> Turnstile, then put the SITE key here
# and the SECRET key in the backend's TURNSTILE_SECRET_KEY.
# Leave empty to keep the captcha off.
VITE_TURNSTILE_SITE_KEY=
