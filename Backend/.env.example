# Copy this file to ".env" and fill in real values.
# NEVER commit the real .env file.

# --- Required ---------------------------------------------------
# MongoDB connection string (Atlas or local)
MONGO_URI=mongodb://127.0.0.1:27017/TYOHARADB

# Long random secret used to sign login tokens.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# The server refuses to start without it.
JWT_SECRET=

# --- Website / hosting ------------------------------------------
# Address(es) of your website. Several can be comma-separated.
FRONTEND_URL=https://tyohara.vercel.app,http://localhost:5173

# Number of proxies in front of the server (Render/Railway/Heroku = 1)
TRUST_PROXY=1

PORT=5000

# --- Razorpay (online payments) ---------------------------------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# --- Shop rules (optional, these are the defaults) --------------
# FREE_DELIVERY_THRESHOLD=1000
# DELIVERY_CHARGE=60
# Set to false to stop checking product stock at checkout
# ENFORCE_STOCK=true
# JWT_EXPIRES_IN=1d

# --- Email verification for new customers (optional) -----------------
# Customers confirm their email with a 6-digit code when they sign up.
# Needs a free Brevo account (brevo.com): create an API key and verify
# the sender address you want emails to come from.
# Turns on only when REQUIRE_EMAIL_VERIFICATION=true AND both values
# below are set. Otherwise signup works as before.
REQUIRE_EMAIL_VERIFICATION=false
BREVO_API_KEY=
MAIL_FROM_EMAIL=
MAIL_FROM_NAME=TYOHARA

# --- Captcha on signup and login (optional) --------------------------
# Cloudflare Turnstile SECRET key. Set the matching SITE key on the
# frontend (VITE_TURNSTILE_SITE_KEY) at the same time. Empty = off.
TURNSTILE_SECRET_KEY=
